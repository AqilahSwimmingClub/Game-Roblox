{
  "name": "@eduverse/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@eduverse/shared": "0.1.0",
    "@socket.io/redis-adapter": "8.3.0",
    "bcryptjs": "2.4.3",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "exceljs": "4.4.0",
    "express": "4.22.3",
    "express-rate-limit": "7.4.0",
    "helmet": "7.1.0",
    "jsonwebtoken": "9.0.2",
    "jszip": "^3.10.1",
    "mammoth": "1.13.0",
    "multer": "1.4.5-lts.1",
    "pdfkit": "0.15.0",
    "pg": "8.12.0",
    "redis": "4.7.0",
    "socket.io": "4.8.4",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/compression": "1.7.5",
    "@types/cookie-parser": "1.4.7",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.6",
    "@types/multer": "1.4.11",
    "@types/node": "20.14.15",
    "@types/pdfkit": "0.13.4",
    "@types/pg": "8.11.6",
    "socket.io-client": "4.8.4",
    "tsx": "4.21.0",
    "typescript": "5.5.4",
    "vitest": "2.0.5"
  },
  "optionalDependencies": {
    "@electric-sql/pglite": "0.4.6",
    "@electric-sql/pglite-socket": "0.1.6"
  }
}
