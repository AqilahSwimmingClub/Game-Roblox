# EDUVERSE — contoh konfigurasi. Salin menjadi ".env" (JANGAN commit .env).
# Server membaca variabel ini dari environment proses (docker compose memuat .env otomatis).

# ── Wajib di produksi ──
NODE_ENV=production
# Koneksi PostgreSQL 14+
DATABASE_URL=postgres://eduverse:GANTI_SANDI_DB@localhost:5432/eduverse
# Rahasia penanda token guru — minimal 32 karakter acak, mis. hasil: openssl rand -hex 32
JWT_SECRET=GANTI_DENGAN_STRING_ACAK_PANJANG
# Alamat publik (HTTPS) yang dibuka siswa; dipakai untuk tautan & QR kelas
PUBLIC_URL=https://eduverse.contoh-sekolah.sch.id

# ── Opsional ──
PORT=3000
# Kode untuk mendaftarkan guru tambahan (guru pertama boleh mendaftar tanpa kode). Kosong = pendaftaran tertutup setelah guru pertama.
TEACHER_REGISTRATION_CODE=
# Redis untuk menjalankan beberapa instance server (Socket.IO adapter). Kosongkan bila hanya 1 instance.
REDIS_URL=
# Isi 1 bila server berada di balik reverse proxy (Nginx/Caddy/load balancer) agar IP klien terbaca benar.
TRUST_PROXY=1
# Batas gabung per IP per menit (satu kelas sering berbagi satu IP sekolah)
JOIN_RATE_PER_MIN=600
# Batas pemain per instance server
MAX_PLAYERS_PER_NODE=600
# 0 = jangan jalankan migrasi database otomatis saat server start
AUTO_MIGRATE=1

# ── Seed akun guru pertama (opsional, dipakai oleh: npm run db:seed) ──
SEED_TEACHER_EMAIL=
SEED_TEACHER_PASSWORD=
SEED_TEACHER_NAME=

# ── docker compose ──
POSTGRES_PASSWORD=GANTI_SANDI_DB
